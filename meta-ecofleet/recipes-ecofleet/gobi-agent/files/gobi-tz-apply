#!/bin/sh
# gobi-tz-apply — root worker that sets the system time zone for gobi-agent.
#
# weather-fetch (unprivileged, sandboxed) resolves the unit's location (IP
# geolocation, configured lat/lon as fallback), gets the IANA zone for it from
# Open-Meteo (timezone=auto) and writes the name to $SHARED when it changes.
# gobi-tz-apply.path starts this worker, which re-validates the name, applies it,
# and restarts gobi-ui so the panel clock follows (glibc only re-reads
# /etc/localtime on process start).
#
# The zone file lives on the slot-shared /data partition, so a freshly updated
# slot already has it at boot (this worker runs before gobi-ui) and the panel
# never shows UTC. Fallbacks, in order: the per-slot copy (units without a
# working /data), then the u-boot environment (ecofleet_tz) — which
# post-install.sh seeds at every update, and is what carries the zone on the
# first boot after updating from a release that kept it per-slot.
set -u

SHARED=/data/ecofleet/timezone
LEGACY=/var/lib/ecofleet/timezone
ZONEINFO=/usr/share/zoneinfo
ENV_KEY=ecofleet_tz
log() { logger -t gobi-tz-apply "$*"; }

if [ -r "$SHARED" ]; then
    tz=$(head -n 1 "$SHARED" | tr -d '\r\n')
elif [ -r "$LEGACY" ]; then
    tz=$(head -n 1 "$LEGACY" | tr -d '\r\n')
else
    tz=$(fw_printenv -n "$ENV_KEY" 2>/dev/null || echo "")
    [ -n "$tz" ] || exit 0           # nothing known yet: stay put until weather-fetch
fi

# Same rule as weather_parse_timezone(): plain zone names only — no absolute
# paths, no "..", nothing outside [A-Za-z0-9_+-/].
case "$tz" in
    ""|/*|*/|*//*|*.*|*[!A-Za-z0-9_+/-]*)
        log "ignoring invalid zone name '$tz'"; exit 0 ;;
esac
if [ ! -f "$ZONEINFO/$tz" ]; then
    log "zone '$tz' is not installed under $ZONEINFO — leaving time zone unchanged"
    exit 0
fi

cur=$(timedatectl show -p Timezone --value 2>/dev/null || echo "")
[ "$cur" = "$tz" ] && exit 0

if ! timedatectl set-timezone "$tz" 2>/dev/null; then
    ln -sf "$ZONEINFO/$tz" /etc/localtime || { log "failed to set $tz"; exit 1; }
fi
log "time zone ${cur:-unset} -> $tz"

# The panel clock only picks up a new zone on restart. Only reached on a real
# change (first boot, or a unit moving into another zone).
systemctl try-restart gobi-ui.service
exit 0
