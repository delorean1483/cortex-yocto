[Unit]
Description=EcoFleet weather forecast fetch (Open-Meteo)
Documentation=https://github.com/your-org/ecofleet-firmware
After=network-online.target data.mount
Wants=network-online.target

[Service]
Type=oneshot
User=ecofleet
Group=ecofleet
ExecStart=/usr/sbin/weather-fetch
StandardOutput=journal
StandardError=journal
SyslogIdentifier=weather-fetch

# Hardening — needs only outbound network and its own state dir
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ecofleet
# Time zone + assigned location live on the slot-shared /data partition (see
# state_path.h). "-": a unit without a working /data still runs, per-slot.
ReadWritePaths=-/data/ecofleet
PrivateTmp=yes

# No [Install]: this unit is started by weather-fetch.timer, not on its own.
