#!/bin/sh
# gobi-ota-apply — root OTA/reboot worker for gobi-agent.
#
# The gobi-agent runs as the unprivileged 'ecofleet' user and is heavily
# sandboxed (NoNewPrivileges + ProtectSystem=strict), so it CANNOT escalate to
# do a firmware install or reboot itself — sudo is blocked by NoNewPrivileges
# (which is exactly why the earlier sudo-helper approach silently failed). So the
# agent just drops a one-line request file, and THIS worker — started as root and
# deliberately un-sandboxed by gobi-ota-apply.path/.service — does the privileged
# work: download the signed bundle, swupdate the inactive A/B slot + u-boot env,
# and reboot.
#
# Request file ($REQ), one line:
#   install <version>   download releases/<version>/ecofleet-<version>.swu, install, reboot
#   reboot              reboot only
# <version> is validated to digits+dots and the URL is built from a fixed base, so
# a request can only ever install a signed bundle from our S3 releases path (and
# swupdate still verifies the signature via CONFIG_SIGNED_IMAGES).
#
# Reboots go through gobi-cold-reboot (BD71847 PMIC I2C cold reset): a normal
# `reboot` hangs this board before U-Boot SPL. See the plan doc.
set -u

REQ=/var/lib/ecofleet/ota/request
CFG=/etc/swupdate/ecofleet.cfg
BASE_URL="https://ecofleet-ota.s3.amazonaws.com/releases"
STATUS=/var/lib/ecofleet/ota/status

# Publish OTA progress; the agent mirrors this file into the shadow as
# reported.ota_status, so a failed OTA shows on the dashboard instead of a stuck
# "pending". (On success the board reboots and the new slot has no status file,
# so it naturally reads back "idle" + the new reported firmware_version.)
status() { printf '%s\n' "$1" > "$STATUS" 2>/dev/null || true; }

[ -f "$REQ" ] || exit 0
read -r cmd arg < "$REQ"
rm -f "$REQ"

case "$cmd" in
    reboot)
        logger -t gobi-ota-apply "reboot requested — PMIC cold reset"
        exec /usr/sbin/gobi-cold-reboot
        ;;
    install)
        # Version must be digits and dots only — no path/URL/shell injection.
        case "$arg" in
            ''|*[!0-9.]*)
                logger -t gobi-ota-apply "refusing install: bad version '$arg'"
                exit 2 ;;
        esac
        swu="/tmp/ecofleet-${arg}.swu"
        url="${BASE_URL}/${arg}/ecofleet-${arg}.swu"

        status "downloading ${arg}"
        logger -t gobi-ota-apply "OTA ${arg}: downloading $url"
        if ! curl -fsSL --max-time 300 -o "$swu" "$url"; then
            status "failed: download ${arg}"
            logger -t gobi-ota-apply "OTA ${arg}: download failed — staying on current slot"
            rm -f "$swu"
            exit 1
        fi

        status "installing ${arg}"
        logger -t gobi-ota-apply "OTA ${arg}: installing"
        swupdate -i "$swu" -f "$CFG"
        rc=$?
        rm -f "$swu"

        if [ "$rc" -eq 0 ]; then
            status "success ${arg}"
            logger -t gobi-ota-apply "OTA ${arg}: install ok — activating via PMIC cold reset"
            exec /usr/sbin/gobi-cold-reboot
        fi
        status "failed: install ${arg} (rc ${rc})"
        logger -t gobi-ota-apply "OTA ${arg}: swupdate failed (exit $rc) — staying on current slot"
        exit "$rc"
        ;;
    *)
        logger -t gobi-ota-apply "ignoring unknown request '$cmd'"
        exit 2 ;;
esac
