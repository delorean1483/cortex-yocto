software =
{
    version = "0.1.0";
    name    = "ecofleet-firmware";

    /* Matched against the REVISION field of the device's /etc/hwrevision
     * ("imx8mm-var-dart 2.0" -> revision "2.0"), NOT the board name. Listing
     * the board name here made every OTA fail "SW not compatible with hardware".
     * 2.0 = boot-partition layout (p1 boot, p2/p3 slots, p4 data); 1.0 units
     * (p1/p2 slots, p3 data) must never take this bundle, nor 2.0 units an old one. */
    hardware-compatibility = ["2.0"];

    images: (
        {
            filename = "rootfs.ext4.gz";
            type     = "raw";
            device   = "/dev/swupdate-inactive";   /* symlink set by pre-install.sh */
            compressed = "zlib";
            sha256   = "@rootfs.ext4.gz";
        }
    );

    scripts: (
        {
            filename = "pre-install.sh";
            type     = "shellscript";
            sha256   = "@pre-install.sh";
            properties: { execute-before-update = ["true"]; };
        },
        {
            filename = "post-install.sh";
            type     = "shellscript";
            sha256   = "@post-install.sh";
            properties: { execute-after-update = ["true"]; };
        }
    );
};
